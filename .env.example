# ODYSSEY backend configuration — copy to `.env` (gitignored) and fill in.
# These values are read ONLY by the Node backend (server/config.ts). Never use a
# VITE_ prefix: Vite would expose such variables to the browser bundle.

# --- Reasoning provider (OpenCode) -------------------------------------------
# OpenCode Console API key. Works with Zen (pay-as-you-go credit) or Go (subscription).
OPENCODE_API_KEY=replace-with-your-opencode-key
# Go subscription endpoint (OpenAI-compatible chat completions). For Zen use:
#   https://opencode.ai/inference/openai/v1
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Any tool-calling chat model available to your plan, e.g. deepseek-v4.1-flash,
# glm-5.3-flash, kimi-k3, gpt-6-luna, claude-haiku-5-5.
OPENCODE_MODEL=deepseek-v4.1-flash
# Sent as `reasoning_effort`. "none" disables DeepSeek's hidden reasoning tokens
# (verified: 0 reasoning tokens). Leave empty for the provider default.
OPENCODE_REASONING_EFFORT=none
OPENCODE_TIMEOUT_MS=90000

# --- Evidence search (Serper, via Earth-Location-Nasa) ------------------------
SERPER_API_KEY=replace-with-your-serper-key

# --- Server -------------------------------------------------------------------
ODYSSEY_PORT=8787
ODYSSEY_HOST=127.0.0.1
# Optional bearer token required on POST endpoints for shared deployments.
ODYSSEY_API_TOKEN=
ODYSSEY_DB=server/data/odyssey.sqlite
ODYSSEY_PYTHON=python3

# --- Agent budgets ------------------------------------------------------------
ODYSSEY_MAX_TOOL_CALLS=64
ODYSSEY_MAX_LLM_TURNS=36
ODYSSEY_MAX_SEARCH_CALLS=12
ODYSSEY_MAX_SOURCE_FETCHES=10
ODYSSEY_RUN_TIMEOUT_MS=720000
ODYSSEY_TOOL_TIMEOUT_MS=120000
ODYSSEY_MAX_CONCURRENT_RUNS=2
