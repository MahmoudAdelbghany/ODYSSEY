{
  "name": "odyssey",
  "version": "1.1.0",
  "private": true,
  "description": "Planetary analog mission planner: finds Earth sites for Moon and Mars experiments, and shows where Earth falls short.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc --noEmit -p tsconfig.server.json && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "test": "tsx --test server/tests/*.test.ts",
    "test:external": "cd external/Earth-Location-Nasa && python3 -m unittest discover -s tests && cd ../Reranker && python3 -B -m unittest test_mission_reranker",
    "test:smoke": "ODYSSEY_SMOKE=1 tsx --test server/tests/smoke.live.test.ts",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "start": "tsx server/index.ts",
    "test:python": "cd scripts && python3 -m unittest test_modis_metadata test_generated_enrichment test_global_discovery",
    "secrets:history": "node scripts/secret-scan.mjs --history"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.2",
    "framer-motion": "^14.11.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-globe.gl": "^2.38.0",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
