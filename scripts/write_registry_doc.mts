/** Writes REQUIREMENT_EVIDENCE_REGISTRY.md from the live registry and the demonstration mission. */
import { writeFileSync, readFileSync } from 'node:fs';
import { decomposeMission } from '../src/mission/index.ts';
import { EVIDENCE_REGISTRY, STATE_INFO, OUTCOME_LABEL, thresholdBasis } from '../src/mission/evidence.ts';

const BRIEF = 'Plan a seven-day simulated lunar surface expedition that includes geological sampling, rover navigation, equipment deployment, thermal survival and dust mitigation.';
const FRAG: Record<string, string> = { geological_sampling: 'geological sampling', rover_navigation: 'rover navigation', equipment_deployment: 'equipment deployment', thermal_survival: 'thermal survival', dust_aeolian: 'dust mitigation' };
const TARGET: Record<string, string> = {
  thermalInertia: 'Moon: 55 ± 2 J m⁻² K⁻¹ s⁻¹ᐟ² at 273 K, Diviner global regolith fines (Hayne et al. 2017, verified from abstract). Mars: 180–605 along the Perseverance traverse (Martínez et al. 2023).',
  lunarNight: 'Moon: ≈ 1.5 days longest continuous darkness at the best-lit Shackleton rim point (Mazarico et al. 2011); permanent darkness in PSRs.',
  gravity: 'Moon 1.62 m/s², Mars 3.73 m/s² (NSSDC).',
  vacuum: 'Moon night-time surface pressure 3 × 10⁻¹⁵ bar (NSSDC).',
  bearingStrength: 'Not ingested. Apollo soils are dense below 5–10 cm (Carrier 2005) but no bearing value is asserted.',
  dustFlux: 'Not applicable as an aeolian quantity: no atmosphere. Lunar dust is lofted electrostatically and by impacts.',
  rockExposure: 'Not ingested (target-side exposure is not used by this requirement).',
};
const ba = JSON.parse(readFileSync(process.argv[2], 'utf8'));
const m = decomposeMission(BRIEF, 'expedition', 'Lunar expedition', [], { archetypes: Object.keys(FRAG).map((id) => ({ id, terms: [FRAG[id]], source: 'brief' as const })) });
const out: string[] = [];
const p = (s = '') => out.push(s);
p('# ODYSSEY: Requirement-to-Evidence Registry');
p();
p('Generated by `scripts/write_registry_doc.mts` from `src/mission/evidence.ts` (the registry the app enforces) and the demonstration mission. Site counts are over the 39 curated sites, recomputed on 2026-11-14.');
p();
p('States: ' + Object.entries(STATE_INFO).map(([k, v]) => `\`${k}\` = ${v.label} (${OUTCOME_LABEL[v.outcome]})`).join('; ') + '.');
p();
p('## Summary');
p();
p('| Requirement | Kind | Threshold basis | Evidence state at the 39 sites | Status at the 39 sites |');
p('|---|---|---|---|---|');
for (const e of m.experiments) for (const r of e.requirements) {
  const row = ba.requirements.find((x: any) => x.id === r.id);
  const fmt = (o: Record<string, number>) => Object.entries(o).map(([k, v]) => `${STATE_INFO[k as keyof typeof STATE_INFO]?.label ?? k} ${v}`).join(', ');
  p(`| ${r.statement} (\`${r.id}\`) | ${r.kind} | ${thresholdBasis(r).label} | ${row ? fmt(row.states) : ''} | ${row ? Object.entries(row.statuses).map(([k, v]) => `${k} ${v}`).join(', ') : ''} |`);
}
p();
for (const e of m.experiments) {
  p(`## ${e.name} (\`${e.id}\`)`);
  p();
  p(`Brief fragment: "${FRAG[e.id]}"`);
  p();
  for (const r of e.requirements) {
    const s = EVIDENCE_REGISTRY[r.metric];
    const t = thresholdBasis(r);
    p(`### ${r.statement}`);
    p();
    p(`| Field | Value |`);
    p(`|---|---|`);
    const rows: Array<[string, string]> = [
      ['Requirement ID', `\`${r.id}\``],
      ['Experiment', `\`${e.id}\``],
      ['Classification', r.kind],
      ['Physical quantity', s?.quantity ?? r.metric],
      ['Unit', s?.unit || r.unit || 'unitless'],
      ['Threshold', r.direction === 'boolean' ? 'present' : `ideal ${r.ideal}, limit ${r.limit}${r.limitMax != null ? `–${r.limitMax}` : ''} (${r.direction} is better)`],
      ['Threshold source', `${t.label}. ${t.note}`],
      ['Why it matters', r.why],
      ['Spatial support', s?.spatialSupport ?? ''],
      ['Temporal support', s?.temporalSupport ?? ''],
      ['Required resolution', s?.requiredResolution ?? ''],
      ['Earth-side datasets', (s?.datasets ?? []).map((d) => `${d.name} [${d.status.replace('_', ' ')}]: ${d.reason}`).join('<br>') || 'none'],
      ['Target reference', TARGET[r.metric] ?? 'Site-side requirement; the target comparison is made per dimension in Where Earth falls short.'],
      ['Derivation method', s?.method ?? ''],
      ['Validation', s?.validation ?? ''],
      ['Limitation', s?.limitation ?? ''],
      ['State with a value / without', s ? `${STATE_INFO[s.stateWithValue].label} / ${STATE_INFO[s.stateWithoutValue].label}` : ''],
      ['If unavailable: what is missing', s?.whatMissing ?? ''],
      ['Next action', s?.nextAction ?? ''],
    ];
    for (const [k, v] of rows) p(`| ${k} | ${String(v).replace(/\|/g, '\\|')} |`);
    p();
  }
}
writeFileSync('REQUIREMENT_EVIDENCE_REGISTRY.md', out.join('\n'));
console.log('wrote', out.length, 'lines');
